  <property name="styleSheet">
   <string notr="true">/* Estilo para la ventana principal */
QDialog {
    background-color: #FAFAFA;
    font-family: &quot;Segoe UI&quot;, &quot;Helvetica Neue&quot;, Arial, sans-serif;
    font-size: 14px;
    color: #333333;
}

/* Estilo para las etiquetas de texto */
QLabel {
    color: #4A4A4A;
    font-weight: 500;
    background: transparent;
}

/* Estilo para los campos de entrada de texto */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #D1D5DB;
    border-radius: 6px;
    padding: 6px 12px;
    color: #1F2937;
    font-size: 13px;
}

/* Estado de enfoque (cuando el usuario hace clic en el QLineEdit) */
QLineEdit:focus {
    border: 1px solid #3B82F6;
    background-color: #FFFFFF;
    /* Un ligero cambio para denotar selección */
}

/* Estado cuando el QLineEdit está deshabilitado */
QLineEdit:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
    border: 1px solid #E5E7EB;
}

/* Estilo para los botones */
QPushButton {
    background-color: #3B82F6;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: 13px;
}

/* Efecto al pasar el cursor sobre el botón */
QPushButton:hover {
    background-color: #2563EB;
}

/* Efecto al hacer clic en el botón */
QPushButton:pressed {
    background-color: #1D4ED8;
}

/* Estado cuando el botón está deshabilitado */
QPushButton:disabled {
    background-color: #E5E7EB;
    color: #9CA3AF;
}</string>
